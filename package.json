{
  "name": "connect-hub-backend",
  "version": "1.0.0",
  "description": "ConnectHub API - NestJS + MySQL + JWT",
  "author": "Rithika Babu",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "prebuild": "prisma generate --schema prisma/schema.prisma",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "prisma generate --schema prisma/schema.prisma && nest start --watch",
    "start:prod": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:baseline": "prisma migrate resolve --applied 0_init",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.11.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "dotenv": "^18.0.9",
    "prettier": "^3.4.2",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
